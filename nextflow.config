//  MANIFEST 

manifest {
    name            = 'Patholon-nf'
    author          = 'Victor Betiku'
    homePage        = 'https://github.com/viskky/patholon'
    mainScript      = 'Patholon.nf'
    nextflowVersion = '25.10.4'
    version         = '1.0.0'
    doi             = ''
}

/*
==================================
    NEXTFLOW CONFIGURATION
    Patholon-nf/nextflow.config
==================================
*/

// DEFAULT PARAMETERS 

params {
    input          = null
    outdir         = "results"
    assembler      = "flye"
    qc_tool        = "fastqc"       // 'fastqc' or 'nanoplot'
    kraken2_db     = null
    hmm_db         = null
    blastp_db      = null           // path to BLASTP protein database
    genome_size    = "5m"
    min_read_len   = 200
    min_contig_len = 500
    threads        = 8
    help           = false

    // MultiQC config
    multiqc_config = "${projectDir}/assets/multiqc_config.yml"
    multiqc_title  = "Patholon Pipeline Report for QC and Taxonomy"
}

// PROCESS DEFAULTS 

process {
    // Default resource allocation
    cpus   = params.threads
    memory = '16.GB'
    time   = '4.h'

    // Error strategy: retry up to 2x with more memory
    errorStrategy = { task.exitStatus in [137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Memory scaling on retry
    memory = { 16.GB * task.attempt }

    // Per-process resource overrides 

    withName: 'FASTQC' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }

    withName: 'NANOPLOT' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }

    withName: 'PORECHOP' {
        cpus   = params.threads
        memory = '8.GB'
        time   = '4.h'
    }

    withName: 'FLYE' {
        cpus   = { params.threads * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: 'MEGAHIT' {
        cpus   = { params.threads * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: 'QUAST' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }

    withName: 'PROKKA' {
        cpus   = params.threads
        memory = '16.GB'
        time   = '6.h'
    }

    withName: 'ABRICATE_AMR' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }
    
    withName: 'ABRICATE_PLASMID' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }

    withName: 'HMMSEARCH' {
        cpus   = params.threads
        memory = '16.GB'
        time   = '4.h'
    }

    withName: 'BLASTP' {
        cpus   = params.threads
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'KRAKEN2' {
        cpus   = params.threads
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: 'KRONATOOLS' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }

    withName: 'MULTIQC' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
}

//  EXECUTION PROFILES 

profiles {

    //Local execution (default) 
    standard {
        process.executor = 'local'
    }

    //  Conda environment 
    conda {
        conda.enabled          = true
        conda.useMamba         = false   // set true if using mamba
        process.conda          = "${projectDir}/environment.yml"
	    conda.cacheDir         = "${projectDir}/.nextflow-conda"
    }

    //  SLURM (HPC cluster)
    slurm {
        process.executor       = 'slurm'
        executor.queueSize     = 100
        executor.submitRateLimit = '5 sec'
    }

}

//  NEXTFLOW EXECUTION SETTINGS 

executor {
    name      = 'local'
    cpus      = Runtime.runtime.availableProcessors()
    memory    = '60 GB'
}

//  REPORTS & LOGS 

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt"
    overwrite = true
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag_${trace_timestamp}.html"
    overwrite = true
}

